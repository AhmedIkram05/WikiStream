[Unit]
Description=WikiStream hourly warehouse parity check
# Serialize with the export one-shot so a Persistent=true catch-up (VM
# downtime) cannot race parity ahead of a still-running export. After= only
# orders starts; the shared flock holds the lock for the whole script run.
After=docker.service network-online.target wikistream-export.service
Wants=network-online.target
# A failed run journals silently; page Slack instantly instead (gap-2).
OnFailure=wikistream-fail-notify@%n.service

[Service]
Type=oneshot
TimeoutStartSec=1800
ExecStart=/usr/bin/flock -w 3600 /run/wikistream-warehouse.lock /opt/wikistream/warehouse/parity.sh
StandardOutput=journal
StandardError=journal
