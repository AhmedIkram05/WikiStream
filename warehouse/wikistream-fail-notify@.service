[Unit]
Description=WikiStream batch job failure notification (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# notify-failure.sh reads only SLACK_WEBHOOK_URL from .env; do not hand the
# notifier the ClickHouse/Grafana secrets via EnvironmentFile.
ExecStart=/opt/wikistream/warehouse/notify-failure.sh %i
