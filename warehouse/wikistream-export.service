[Unit]
Description=WikiStream hourly BigQuery export
After=docker.service network-online.target
Wants=network-online.target
# A failed run journals silently; page Slack instantly instead (gap-2).
OnFailure=wikistream-fail-notify@%n.service

[Service]
Type=oneshot
TimeoutStartSec=1800
# Shared lock with parity.sh: a Persistent=true catch-up can start parity while
# an export is already active, which After= alone does not prevent.
ExecStart=/usr/bin/flock -w 3600 /run/wikistream-warehouse.lock /opt/wikistream/warehouse/export.sh
StandardOutput=journal
StandardError=journal
