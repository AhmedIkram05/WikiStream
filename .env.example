# WikiStream environment configuration (development defaults)
# Copy to .env and adjust for your environment.

# ClickHouse connection
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=wikistream
CLICKHOUSE_PASSWORD=wikistream_dev_password
# Grafana uses this read-only identity, never the write password.
CLICKHOUSE_RO_PASSWORD=wikistream_ro_dev_password

# GCP project for project-scoped datasources and image defaults.
GCP_PROJECT=wikistream-505003

# Wikimedia recent changes stream
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
USER_AGENT=WikiStream/1.0

# Consumer state directory (stream offset persistence)
STATE_DIR=./state

# Healthcheck: mark unhealthy if no events for this many seconds
HEALTH_STALE_SECONDS=300
HEALTHCHECK_TABLE=default.raw_events

# Docker volume path for ClickHouse data
CH_DATA_DIR=ch-data

# Grafana admin password and plugins
GF_SECURITY_ADMIN_PASSWORD=admin
GF_PLUGINS_PREINSTALL=

# Slack alerting webhook (optional)
SLACK_WEBHOOK_URL=

# Consumer image tag used by docker compose (also runs the data-quality gate)
CONSUMER_IMAGE=wikistream-consumer:local

# Data-quality gate target and window
DATA_QUALITY_TABLE=default.raw_events
DATA_QUALITY_WINDOW_HOURS=1
DATA_QUALITY_ROW_MIN=50000
DATA_QUALITY_ROW_MAX=5000000
